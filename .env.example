# IsfridVerse environment variables
# ------------------------------------------------------------
# 1. Copy this file to `.env.local` (that file is git-ignored).
# 2. Fill in the values. Never commit real keys.
#
# Rule of thumb:
#   NEXT_PUBLIC_*  -> copied into the browser bundle. Only put values here
#                     that are safe for anyone to see.
#   everything else -> server only. Never prefix a secret with NEXT_PUBLIC_.

# --- Site (Phase 2) -------------------------------------------
# The address the site runs at. Used later for sitemap, Open Graph and auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ------------------------------------------------
# Use the IsfridVerse project only, never another app's project.
# Supabase dashboard -> your project -> Project Settings -> API Keys
# Project URL, looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_ . Safe in the browser because
# Row Level Security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with sb_secret_ . SERVER ONLY. It bypasses Row Level
# Security, so it must never reach the browser. Used by `npm run test:rls`
# (to create and delete test users) and later by admin user management.
SUPABASE_SECRET_KEY=

# Database connection string. SERVER ONLY. Used by `npm run db:push`.
# Dashboard -> Connect (top bar) -> "Session pooler" -> URI. Replace
# [YOUR-PASSWORD] with the database password you chose for the project.
# Looks like postgresql://postgres.abcdefgh:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Images ---------------------------------------------------
# Leave empty: images are served from Supabase Storage (bucket "images").
# When images move to another host (e.g. Cloudflare R2), copy the files and
# set this to the folder address that contains covers/ and chapters/.
NEXT_PUBLIC_IMAGE_BASE_URL=

# --- Added in later phases ------------------------------------
# Database backups (Phase 10): stored as GitHub Actions secrets, not here.
